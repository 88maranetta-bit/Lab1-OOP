<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="La1.MainPage"
             BackgroundColor="#1E1E1E">

    <VerticalStackLayout Spacing="8" Padding="12">

        <Label Text="Електронна таблиця (калькулятор)"
               FontSize="20"
               FontAttributes="Bold"
               TextColor="White"
               HorizontalOptions="Start" />

        <Grid ColumnDefinitions="*, Auto" ColumnSpacing="10">
            <Entry x:Name="textInput"
                   Placeholder="Введіть формулу..."
                   IsEnabled="False"
                   BackgroundColor="#2A2A2A"
                   TextColor="White"
                   PlaceholderColor="Gray"
                   Grid.Column="0" />

            <HorizontalStackLayout Spacing="8" Grid.Column="1" VerticalOptions="Center">
                <Button Text="Зберегти" Clicked="SaveButton_Clicked" BackgroundColor="#E67E22" TextColor="White" />
                <Button Text="Очистити таблицю" BackgroundColor="Blue" TextColor="White" Clicked="ClearButton_Clicked" />
                <Button Text="Довідка" Clicked="HelpButton_Clicked" BackgroundColor="#27AE60" TextColor="White" />
                <Button Text="Вийти" Clicked="ExitButton_Clicked" BackgroundColor="#C0392B" TextColor="White" />
            </HorizontalStackLayout>
        </Grid>

        <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center">
                <Label Text="Збережені таблиці" TextColor="White" VerticalOptions="Center" FontSize="14"/>
                <Picker x:Name="savedFilesPicker" 
                        WidthRequest="160" 
                        BackgroundColor="#2A2A2A" 
                        TextColor="White"
                        SelectedIndexChanged="SavedFilesPicker_SelectedIndexChanged" />
                <Button Text="Прочитати" Clicked="ReadButton_Clicked" BackgroundColor="#E67E22" TextColor="White" />
                <Button Text="- рядок" Clicked="DeleteRowButton_Clicked" BackgroundColor="#E67E22" TextColor="White" />
                <Button Text="- стовпчик" Clicked="DeleteColumnButton_Clicked" BackgroundColor="#E67E22" TextColor="White" />
                <Button Text="+ рядок" Clicked="AddRowButton_Clicked" BackgroundColor="#E67E22" TextColor="White" />
                <Button Text="+ стовпчик" Clicked="AddColumnButton_Clicked" BackgroundColor="#E67E22" TextColor="White" />

                <Label Text="Показувати формули:" TextColor="White" VerticalOptions="Center" FontSize="14" Margin="10,0,0,0"/>
                <Switch x:Name="showFormulasSwitch" Toggled="ShowFormulasSwitch_Toggled" VerticalOptions="Center"/>
            </HorizontalStackLayout>
        </ScrollView>

        <ScrollView Orientation="Both" VerticalScrollBarVisibility="Always" HorizontalScrollBarVisibility="Always">
            <Grid x:Name="grid" RowSpacing="1" ColumnSpacing="1" BackgroundColor="#333333" />
        </ScrollView>

    </VerticalStackLayout>

</ContentPage>