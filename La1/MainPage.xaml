<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="La1.MainPage"
             BackgroundColor="#1E1E1E">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">

            <Label Text="Електронна таблиця (калькулятор)"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalOptions="Start" />

            <Grid ColumnDefinitions="*, Auto, Auto, Auto, Auto, Auto" ColumnSpacing="6">
                <Entry x:Name="textInput"
                       Placeholder="Введіть формулу..."
                       BackgroundColor="#2A2A2A"
                       TextColor="White"
                       PlaceholderColor="Gray"
                       Grid.Column="0" />

                <Button Text="Зберегти" Clicked="SaveButton_Clicked" BackgroundColor="#033500" TextColor="White" Grid.Column="1" />
                <Button Text="Очистити таблицю" Clicked="ClearButton_Clicked" BackgroundColor="#001960" TextColor="White" Grid.Column="2" />
                <Button Text="Про програму" Clicked="ShowAboutInfo_Clicked" BackgroundColor="#4E342E" TextColor="White" Grid.Column="3" />
                <Button Text="Довідка" Clicked="ShowVariant6Reference_Clicked" BackgroundColor="#808000" TextColor="White" Grid.Column="4" />
                <Button Text="Вийти" Clicked="ExitButton_Clicked" BackgroundColor="#C0392B" TextColor="White" Grid.Column="5" />
            </Grid>

            <HorizontalStackLayout Spacing="8" Margin="0,5,0,10">
                <Label Text="Збережені таблиці:" VerticalOptions="Center" TextColor="White" />
                <Picker x:Name="savedFilesPicker" 
                        WidthRequest="120" 
                        BackgroundColor="#2A2A2A" 
                        TextColor="White"
                        SelectedIndexChanged="SavedFilesPicker_SelectedIndexChanged" />

                <Button Text="- рядок" Clicked="DeleteRowButton_Clicked" BackgroundColor="#D35400" TextColor="White" />
                <Button Text="- стовпчик" Clicked="DeleteColumnButton_Clicked" BackgroundColor="#D35400" TextColor="White" />
                <Button Text="+ рядок" Clicked="AddRowButton_Clicked" BackgroundColor="#D35400" TextColor="White" />
                <Button Text="+ стовпчик" Clicked="AddColumnButton_Clicked" BackgroundColor="#D35400" TextColor="White" />

                <Label Text="Показувати формулу:" VerticalOptions="Center" TextColor="White" Margin="10,0,0,0" />
                <Switch x:Name="showFormulasSwitch" Toggled="ShowFormulasSwitch_Toggled" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <ScrollView Orientation="Both">
                <Grid x:Name="grid" 
                      RowSpacing="1" 
                      ColumnSpacing="1" 
                      BackgroundColor="#444444" />
            </ScrollView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>